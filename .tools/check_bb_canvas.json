[
  { "eval": "'ready:' + (typeof Admin)" },
  { "wait": 2500 },
  { "eval": "Admin.navigate('compose'); 'nav-ok'" },
  { "wait": 5000 },
  { "eval": "JSON.stringify({hasCanvas: !!document.getElementById('cmp-bb-canvas'), hasEditor: !!document.getElementById('cmp-bb-editor'), sizeTip: document.getElementById('cmp-bb-size')?.textContent, canvasAR: document.getElementById('cmp-bb-canvas')?.style.aspectRatio, empty: !!document.querySelector('.cmp-bb-empty'), noResult: !document.getElementById('cmp-result'), promptLen: (document.getElementById('cmp-prompt')?.value||'').length})" },
  { "click": "#cmp-bb-add-char" },
  { "wait": 1800 },
  { "eval": "JSON.stringify({boxes: document.querySelectorAll('.cmp-bb-box').length, tags: [...document.querySelectorAll('.cmp-bb-tag')].map(x=>x.textContent), cap: document.querySelector('.cmp-bb-cap')?.textContent.slice(0,50), editorRows: document.querySelectorAll('#cmp-bb-editor [data-bf]').length})" },
  { "shot": "bb-canvas-1.png" },
  { "click": "#cmp-bb-add-obj" },
  { "wait": 500 },
  { "click": "#cmp-bb-add-text" },
  { "wait": 800 },
  { "eval": "JSON.stringify({boxes: document.querySelectorAll('.cmp-bb-box').length, types: [...document.querySelectorAll('.cmp-bb-box')].map(x=>x.className.match(/t-\\w+/)?.[0])})" },
  { "eval": "const t=document.querySelector('.cmp-bb-box.t-text'); t.dispatchEvent(new PointerEvent('pointerdown',{bubbles:true,clientX:t.getBoundingClientRect().left+8,clientY:t.getBoundingClientRect().top+8})); 'down'" },
  { "eval": "JSON.stringify({selEditor: !!document.querySelector('#cmp-bb-editor [data-bf=type]'), textInput: !!document.querySelector('#cmp-bb-editor [data-bf=text]')})" },
  { "eval": "const ti=document.querySelector('#cmp-bb-editor [data-bf=text]'); ti.value='第三章 · 暗影纪元'; ti.dispatchEvent(new Event('input',{bubbles:true})); 'typed'" },
  { "wait": 1500 },
  { "eval": "JSON.stringify({promptHead: (document.getElementById('cmp-prompt')?.value||'').slice(0,120), promptHasLayout: (document.getElementById('cmp-prompt')?.value||'').includes('bbox_coord_space')})" },
  { "shot": "bb-canvas-2.png", "full": true },
  { "eval": "const ed=document.querySelector('#cmp-bb-editor [data-bact=del-box]'); ed ? (ed.click(), 'deleted') : 'no-btn'" },
  { "wait": 600 },
  { "eval": "JSON.stringify({boxesAfterDel: document.querySelectorAll('.cmp-bb-box').length})" }
]
